<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.fcast.receiver" name="FCast Receiver" version="0.9.9~pre" provider-name="ozankiratli">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.adaptive" version="21.5.9"/>
    </requires>
    <extension point="xbmc.service" library="resources/lib/startup.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en">FCast Receiver</summary>
        <description lang="en">FCast receiver for Kodi</description>
        <license>GNU General Public License, v2</license>
        <language></language>
        <source>https://github.com/ozankiratli/kodi-fcast-receiver</source>
        <email>ozankiratli@protonmail.com</email>
        <assets>
            <icon>icon.png</icon>
        </assets>
        <news>Test build for FCast protocol v3. Adds the Initial handshake, PlayUpdate and media events, so a sender's own queue moves on when an item finishes; playlists the receiver walks itself; cast photos through Kodi's picture viewer, downloaded before they are shown; volume in both directions; and add-on settings.</news>
    </extension>
</addon>