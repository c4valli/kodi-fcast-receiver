<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Add-on settings, in the format Kodi 19 and later expect: a single section
  named after the add-on, holding categories of grouped settings. Labels are
  numeric ids looked up in resources/language/*/strings.po, which is the only
  form the settings dialog accepts - literal text renders as nothing.

  Every id here is also listed in fcast_plugin/settings.py, and the tests
  check the two against each other: a setting the code asks for by a name that
  is not in this file reads as its default forever, silently.
-->
<settings version="1">
    <section id="service.fcast.receiver">

        <category id="general" label="32000">
            <group id="1" label="32001">
                <setting id="show_notifications" type="boolean" label="32002" help="32003">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

        <category id="pictures" label="32010">
            <group id="1" label="32011">
                <setting id="preload_images" type="boolean" label="32016" help="32017">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="keep_awake_for_pictures" type="boolean" label="32019" help="32020">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="2" label="32018">
                <setting id="playlist_image_duration" type="integer" label="32012" help="32013">
                    <level>0</level>
                    <default>10</default>
                    <constraints>
                        <!-- 351 is Kodi's own "Off", so the bottom of the
                             range reads as what it means rather than "0 sec". -->
                        <minimum label="351">0</minimum>
                        <step>5</step>
                        <maximum>300</maximum>
                    </constraints>
                    <!-- The control Kodi's own slideshow.staytime uses, down
                         to the format label: 14045 is "{0:d} sec" from the
                         core strings, already translated everywhere. -->
                    <control type="spinner" format="string">
                        <formatlabel>14045</formatlabel>
                    </control>
                </setting>
                <setting id="playlist_image_duration_override" type="boolean" label="32014" help="32015">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <!-- Nothing to override when the duration is 0, which
                             means "leave the picture up". -->
                        <dependency type="enable" operator="gt" setting="playlist_image_duration">0</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>

    </section>
</settings>
